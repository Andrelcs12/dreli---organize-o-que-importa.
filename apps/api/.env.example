# Em ambientes IPv4, copie a URI da Session Pooler em Supabase Dashboard > Connect.
# Mantenha sslmode=require quando vier na URI fornecida pelo painel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
WEB_ORIGIN="http://localhost:3000"
PORT="4000"

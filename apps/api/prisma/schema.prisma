generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  /// Mirrors Supabase auth.users.id when Supabase Auth is connected.
  id                   String    @id @db.Uuid
  name                 String?
  currentFocus         String?   @db.VarChar(140) @map("current_focus")
  priorities           String[]  @default([]) @db.VarChar(50)
  homePreference       String?   @db.VarChar(50) @map("home_preference")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  savedLinks           SavedLink[]

  @@map("profiles")
}

enum SavedLinkStatus {
  INBOX
  LIBRARY
  ARCHIVED
}

model SavedLink {
  id          String          @id @default(uuid()) @db.Uuid
  profileId   String          @map("profile_id") @db.Uuid
  url         String          @db.Text
  domain      String          @db.VarChar(255)
  title       String?         @db.VarChar(300)
  description String?         @db.VarChar(500)
  imageUrl    String?         @map("image_url") @db.Text
  status      SavedLinkStatus @default(INBOX)
  isFavorite  Boolean         @default(false) @map("is_favorite")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, url])
  @@index([profileId, status, createdAt])
  @@index([profileId, isFavorite, createdAt])
  @@map("saved_links")
}
